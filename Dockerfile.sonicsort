# syntax=docker/dockerfile:1
#
# Source build of this fork for SonicSort (poslogica/sonicsort), which uses
# MinIO as its S3-compatible object store.
#
# Upstream minio/minio is archived: its last image (quay.io/minio/minio,
# RELEASE.2025-09-07, go1.24.6) will never be rebuilt, and SonicSort's image
# scan gate found 17 Critical / 69 High CVEs in it, nearly all in the Go
# stdlib and vendored Go modules rather than MinIO's own code. This builds
# the fork's branch from source with a current Go toolchain and the
# vulnerable modules bumped in go.mod (see govulncheck), onto a scratch
# image with no shell or package manager (runtime files from our own Debian
# base -- see the rootfs stage).
#
# Version stamping: .dockerignore excludes .git, so buildscripts/
# gen-ldflags.go can't read the commit here. The caller passes
# RELEASE_TAG/COMMIT_ID instead, in the same
# "RELEASE.<date>.hotfix.<sha>" form the Makefile's hotfix target uses.
#
#   docker build -f Dockerfile.sonicsort \
#     --build-arg COMMIT_ID=$(git rev-parse HEAD) -t sonicsort-minio:local .

# Base for the runtime-files stage (rootfs, below). SonicSort passes
# sonicsort-debian:local -- its own trixie-slim from poslogica/debuerreotype;
# the default is the public image of the same variant.
ARG DEBIAN_BASE=debian:trixie-slim

FROM golang:1.27-alpine AS build

ARG RELEASE_TAG=RELEASE.2025-10-15T17-29-55Z
ARG COMMIT_ID=unknown

ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

# Version is the RFC3339 form of the release tag's date (what upstream's
# gen-ldflags.go derives from it).
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    VERSION=$(echo "${RELEASE_TAG}" | sed -E 's/^RELEASE\.([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2})-([0-9]{2})-([0-9]{2})Z.*/\1T\2:\3:\4Z/') && \
    SHORT=$(echo "${COMMIT_ID}" | cut -c1-12) && \
    go build -tags kqueue -trimpath -o /out/minio -ldflags "-s -w \
      -X github.com/minio/minio/cmd.Version=${VERSION} \
      -X github.com/minio/minio/cmd.ReleaseTag=${RELEASE_TAG}.hotfix.${SHORT} \
      -X github.com/minio/minio/cmd.CommitID=${COMMIT_ID} \
      -X github.com/minio/minio/cmd.ShortCommitID=${SHORT} \
      -X github.com/minio/minio/cmd.CopyrightYear=2025" .

# Stand-in for upstream's `mc ready local` healthcheck: the scratch runtime has no
# shell/curl/mc, and shipping mc would bring its own Go dependency tree (and
# CVEs) along. Stdlib only.
WORKDIR /healthcheck
COPY <<'EOF' main.go
package main

import (
	"net/http"
	"os"
	"time"
)

func main() {
	url := "http://127.0.0.1:9000/minio/health/live"
	if len(os.Args) > 1 {
		url = os.Args[1]
	}
	client := http.Client{Timeout: 3 * time.Second}
	resp, err := client.Get(url)
	if err != nil || resp.StatusCode != http.StatusOK {
		os.Exit(1)
	}
}
EOF
RUN --mount=type=cache,target=/root/.cache/go-build \
    go mod init healthcheck && go build -trimpath -ldflags "-s -w" -o /out/minio-healthcheck .

# Runtime filesystem for the scratch image below, assembled on SonicSort's own
# Debian base (sonicsort-debian:local, from poslogica/debuerreotype) in place of
# gcr.io/distroless/static-debian13. Same contents distroless/static gives a
# static Go binary: CA certificates, tzdata, mime types, services/protocols,
# passwd/group (root, nobody, nonroot) and a 1777 /tmp -- plus the dpkg
# status.d entries and os-release that let scanners see those packages.
FROM ${DEBIAN_BASE} AS rootfs
# Weekly cache-buster (SonicSort's build scripts pass the current ISO week),
# so the packages copied below are re-fetched at least weekly.
ARG OS_PATCH_WEEK=unset
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates tzdata media-types netbase; \
    mkdir -p /out/etc/ssl/certs /out/usr/share /out/usr/lib /out/var/lib/dpkg/status.d /out/tmp; \
    cp /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/; \
    cp -a /usr/share/zoneinfo /out/usr/share/; \
    cp /etc/mime.types /etc/services /etc/protocols /etc/nsswitch.conf /out/etc/; \
    cp /usr/lib/os-release /out/usr/lib/; \
    ln -s ../usr/lib/os-release /out/etc/os-release; \
    for pkg in base-files ca-certificates tzdata media-types netbase; do \
        dpkg-query --status "$pkg" > "/out/var/lib/dpkg/status.d/$pkg"; \
    done; \
    chmod 1777 /out/tmp;     install -d -o 65532 -g 65532 /out/data /out/home/nonroot; \
    rm -rf /var/lib/apt/lists/*
COPY <<'EOF' /out/etc/passwd
root:x:0:0:root:/root:/sbin/nologin
nobody:x:65534:65534:nobody:/nonexistent:/sbin/nologin
nonroot:x:65532:65532:nonroot:/home/nonroot:/sbin/nologin
EOF
COPY <<'EOF' /out/etc/group
root:x:0:
nobody:x:65534:
nonroot:x:65532:
EOF

# Runs as distroless's nonroot user (uid/gid 65532, defined in the passwd and
# group above) rather than root (sonicsort #154). /data and its home
# (~/.minio, where MinIO looks for TLS certs) are created owned by it above.
# A data volume created while MinIO ran as root must be handed to 65532 once:
# SonicSort's compose file and k8s manifest do that before MinIO starts.
FROM scratch

COPY --from=rootfs /out/ /
COPY --from=build /out/minio /out/minio-healthcheck /usr/bin/

EXPOSE 9000 9001
VOLUME ["/data"]

USER 65532:65532
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data"]
